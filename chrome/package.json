    "webpack": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack",
    "ladybird": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack.ladybird.js"
  },
