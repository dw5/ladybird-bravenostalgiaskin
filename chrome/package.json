    "font-awesome": "^4.5.0",
    "immutable": "^3.7.5",
    "immutablediff": "^0.4.2",
    "lru-cache": "^4.1.5",
    "niceware": "^1.0.4",
    "prettier-bytes": "^1.0.3",
